# Template only. Copy to .env before entering your real key.
GEMINI_API_KEY=replace-with-server-side-key
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Optional legacy override: GEMINI_LIVE_MODEL (takes precedence over default).
# Model IDs sourced from supplied screenshot; verify availability in your account.
PORT=8787
# Set to your PostgreSQL connection string. Production requires this.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Keep this stable; it is used to hash IP/account quota identifiers.
# DAILY_QUOTA_SECRET=replace-with-a-long-random-secret
# If behind a reverse proxy, list only trusted proxy IPs/CIDRs, comma-separated.
# TRUST_PROXY=127.0.0.1
