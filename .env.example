# Template only. Copy to .env before entering your real key.
GEMINI_API_KEY=replace-with-server-side-key
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Optional Google OAuth; set all three values to enable sign-in.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback
# SESSION_SECRET=replace-with-a-long-random-session-secret
# Optional comma-separated Google account emails granted admin quota bypass.
# ADMIN_GOOGLE_EMAILS=admin@example.com
# Optional legacy override: GEMINI_LIVE_MODEL (takes precedence over default).
# Model IDs sourced from supplied screenshot; verify availability in your account.
PORT=8787
# Set to your Supabase PostgreSQL connection string. Production requires this.
# Find in Supabase: Project Settings -> Database -> Connection string -> URI
# Connection Pooler URI (recommended for IPv4 and serverless/PaaS like Render):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct Connection URI (port 5432):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
# Note: URL-encode any special characters in [password] (e.g. @ as %40, # as %23).
# If your database uses a private CA, provide its PEM value through this secret.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----...
# Required for Supabase (prevents SELF_SIGNED_CERT_IN_CHAIN while keeping TLS active):
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Keep this stable; it is used to hash IP/account quota identifiers.
# DAILY_QUOTA_SECRET=replace-with-a-long-random-secret
# Render Blueprint sets TRUST_PROXY=1 for the single trusted Render edge proxy.
# For another proxy setup, specify only trusted IPs/CIDRs, comma-separated.
# TRUST_PROXY=127.0.0.1
# Optional comma-separated, fixed browser origin allowlist.
# PUBLIC_ORIGIN=https://your-service.onrender.com
# Canonical production origin for metadata and the sitemap (no trailing slash).
# Defaults to the project's production domain; change for another deployment.
SITE_URL=https://sonora.rawse.in
# For a custom domain, also set PUBLIC_ORIGIN to allow its API requests.
# PUBLIC_ORIGIN=https://sonora.rawse.in
# Optional Search Console HTML-tag verification: paste only the content value.
# This public ownership token is separate from Google OAuth credentials.
# GOOGLE_SITE_VERIFICATION=your-search-console-verification-value
